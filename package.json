{
  "name": "@jasperan/ckg",
  "version": "0.2.0",
  "description": "Code Knowledge Graph (CKG) — structure-aware retrieval for coding agents. Parses Python codebases into typed graphs (imports/calls/co-edits), optionally stores them in Oracle AI Database PGQ, and injects dependency-aware context into pi, Claude Code & Codex so agents find the right files faster.",
  "license": "MIT",
  "author": "Nacho Martinez <jasperan@users.noreply.github.com>",
  "homepage": "https://github.com/jasperan/ckg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasperan/ckg.git"
  },
  "bugs": {
    "url": "https://github.com/jasperan/ckg/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "claude-plugin",
    "code-graph",
    "dependency-graph",
    "retrieval",
    "pagerank",
    "oracle",
    "pgq",
    "graphrag",
    "agent-context",
    "code-knowledge-graph"
  ],
  "files": [
    "pi/",
    "skills/",
    "src/",
    ".claude-plugin/",
    "hooks/",
    "commands/",
    "scripts/",
    "pyproject.toml",
    "uv.lock",
    "README.md",
    "LICENSE",
    "install.sh",
    "!**/__pycache__/**",
    "!**/*.py[cod]",
    "!**/*.egg-info/**"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "typecheck": "tsc -p pi/tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/node": "^22.19.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./pi/extensions/ckg/index.ts"
    ],
    "skills": [
      "./skills/ckg",
      "./skills/ckg-pi"
    ],
    "image": "https://raw.githubusercontent.com/jasperan/ckg/main/docs/ckg-banner.png"
  }
}
